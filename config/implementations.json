{
  "schemaVersion": 1,
  "note": "第三方实现登记。tsc 兼容实现用 tsc-cli 驱动；Bun 内置检查器用 bun-check 独立 adapter。只登记可复现的获取方式，能力差异显式记录。",
  "implementations": {
    "bun-check-1.4.4": {
      "displayName": "Bun built-in TypeScript checker (bun check)",
      "adapter": "bun-check",
      "kind": "native",
      "tsVersion": "7.0.2 (embedded)",
      "acquisition": {
        "release": {
          "repo": "oven-sh/bun",
          "version": "1.4.4",
          "tag": "bun-v1.4.4",
          "url": "https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/bun-{platform}.zip",
          "bin": "bun-{platform}/bun",
          "fallbackBin": "bun"
        },
        "localEnv": "BUN_CHECK_BIN"
      },
      "cliArgs": [
        "--no-script",
        "--no-pretty",
        "--all",
        "--timing"
      ],
      "baselines": [
        "7.1.0-beta-official",
        "7.1.0-beta"
      ],
      "phaseMetrics": {
        "flag": "--timing",
        "checkField": "checked in",
        "extra": "stderr: \"<n> files loaded in <ms>, <n> checked in <ms>\"; no JSON output",
        "parallelControls": [
          "--threads"
        ]
      },
      "notes": "Bun 1.4.4 内置 typescript-go 移植（process.versions.typescript=7.0.2）；诊断在 stdout/stderr（按环境），无 JSON。target 支持至 es2025/esnext，es2026 被拒；harness 物化 tsconfig，不剥离类型选项。"
    },
    "bun-check-1.4.5": {
      "displayName": "Bun built-in TypeScript checker (bun check)",
      "adapter": "bun-check",
      "kind": "native",
      "tsVersion": "7.0.2 (embedded)",
      "acquisition": {
        "release": {
          "repo": "oven-sh/bun",
          "version": "1.4.5",
          "tag": "bun-v1.4.5",
          "url": "https://github.com/oven-sh/bun/releases/download/bun-v1.4.5/bun-{platform}.zip",
          "bin": "bun-{platform}/bun",
          "fallbackBin": "bun"
        },
        "localEnv": "BUN_CHECK_BIN"
      },
      "cliArgs": [
        "--no-script",
        "--no-pretty",
        "--all",
        "--timing"
      ],
      "baselines": [
        "7.1.0-beta-official",
        "7.1.0-beta"
      ],
      "phaseMetrics": {
        "flag": "--timing",
        "checkField": "checked in",
        "extra": "stderr: \"<n> files loaded in <ms>, <n> checked in <ms>\"; no JSON output",
        "parallelControls": [
          "--threads"
        ]
      },
      "notes": "Bun 1.4.5 内置 typescript-go 移植（process.versions.typescript=7.0.2）；诊断在 stdout/stderr（按环境），无 JSON。target 支持至 es2025/esnext，es2026 被拒；harness 物化 tsconfig，不剥离类型选项。"
    },
    "tsrs": {
      "displayName": "tsrs (oxc-tsrs)",
      "adapter": "tsc-cli",
      "tsVersion": "7.1.0-beta",
      "upstreamPin": "microsoft/TypeScript@3e9236361fa9",
      "acquisition": {
        "npm": {
          "package": "tsrs",
          "version": "0.25.0-ts7.1.0-beta",
          "bin": "node_modules/.bin/tsrs"
        },
        "cargo": {
          "repo": "reference/oxc-tsrs",
          "command": "cargo build --release -p tsrs_cli",
          "bin": "target/release/tsrs"
        },
        "localEnv": "TSRS_BIN"
      },
      "cliArgs": ["--singleThreaded"],
      "baselines": ["7.1.0-beta", "7.1.0-beta-official"],
      "phaseMetrics": {
        "flag": "--extendedDiagnostics",
        "checkField": "Check time",
        "parallelControls": ["--singleThreaded", "--checkers"]
      },
      "notes": "npm 预编译含 darwin/linux 平台包；相位输出完整（Parse/Bind/Check/Total + Program/Checkers 明细）。"
    },
    "tsc-rs": {
      "displayName": "tsc-rs (kazhiramatsu)",
      "adapter": "tsc-cli",
      "tsVersion": "7.1.0-dev",
      "upstreamPin": "microsoft/TypeScript@aa8149273b23401f0a79a5f0384c42de51888693",
      "acquisition": {
        "cargo": {
          "repo": "reference/tsc-rs",
          "git": {
            "url": "https://github.com/kazhiramatsu/tsc-rs",
            "ref": "2b006e078d5b535185f5aeea04406eab7b8aee3c"
          },
          "command": "cargo build --release --locked -p tsc-rs-cli",
          "bin": "target/release/tsc-rs"
        },
        "localEnv": "TSC_RS_BIN"
      },
      "cliArgs": ["--checkers", "1"],
      "baselines": ["7.1.0-beta-official"],
      "phaseMetrics": {
        "flag": "--extendedDiagnostics",
        "checkField": "Check time",
        "extra": "TSRS_PHASE_TRACE=1 输出逐相位行（含 rss）",
        "parallelControls": ["--checkers", "--singleThreaded"]
      },
      "notes": "无 npm 包；extended 默认无 Bind/Emit 字段。"
    },
    "ts-rust": {
      "displayName": "ts-rust (pingdotgg)",
      "adapter": "tsc-cli",
      "tsVersion": "7.1.0-beta",
      "upstreamPin": "microsoft/TypeScript@3e9236361fa9",
      "acquisition": {
        "npm": {
          "package": "tsc-rs",
          "version": "0.8.0",
          "bin": "node_modules/.bin/tsc-rs"
        },
        "cargo": {
          "repo": "reference/ts-rust",
          "command": "cargo build --release --locked -p ts_goport --bin tsgo",
          "bin": "target/release/tsgo"
        },
        "localEnv": "TS_RUST_BIN"
      },
      "cliArgs": ["--singleThreaded"],
      "baselines": ["7.1.0-beta", "7.1.0-beta-official"],
      "phaseMetrics": {
        "flag": "--extendedDiagnostics",
        "checkField": "Check time",
        "parallelControls": ["--singleThreaded", "--checkers"]
      },
      "notes": "npm 包名为 tsc-rs（含平台原生包）；字段与 tsgo 一致。"
    },
    "tsz": {
      "displayName": "tsz",
      "adapter": "tsc-cli",
      "tsVersion": "7.0.2",
      "upstreamPin": "",
      "acquisition": {
        "cargo": {
          "repo": "reference/tsz",
          "git": {
            "url": "https://github.com/tsz-org/tsz",
            "ref": "0b4641ac285f5991a3e805e395e7e4f9ef71f90e"
          },
          "command": "cargo build --release --locked -p tsz-cli --bin tsz",
          "env": { "CI": "1" },
          "bin": "target/release/tsz"
        },
        "localEnv": "TSZ_BIN"
      },
      "cliArgs": [],
      "baselines": ["7.1.0-beta-official"],
      "phaseMetrics": {
        "flag": "--extendedDiagnostics",
        "checkField": "Check",
        "extra": "Parse 与 Bind 合并为 Parse & Bind；无并行度开关",
        "parallelControls": []
      },
      "notes": "目标 TS 7.0.2；构建需 CI=1 与外部 CARGO_TARGET_DIR（仓库默认会把产物写进检出）。"
    }
  }
}
